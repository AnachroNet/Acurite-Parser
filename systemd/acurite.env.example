# Copy to /etc/acurite/acurite.env and chmod 600. Loaded by acurite.service.
# See CONFIGURATION.txt for all site-specific settings.

# --- Pipeline (optional overrides) ---
# ACURITE_DIR=/opt/acurite
# RTL433_BIN=/usr/local/bin/rtl_433
# RTL433_CONF=/opt/acurite/rtl_433.conf
# RTL433_ARGS=-g 40
# RTL433_LOG=1
# PYTHON=python3

# --- PostgreSQL (required: set password) ---
ACURITE_DB_HOST=postgresql.example.com
ACURITE_DB_PORT=5432
ACURITE_DB_NAME=acurite
ACURITE_DB_USER=acurite
ACURITE_DB_PASSWORD=replace_me
ACURITE_TIMEZONE=America/New_York
